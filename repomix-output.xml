  background: radial-gradient(circle at top, #fff2df 0%, #f6f1ea 40%, #efe2d3 100%);
}

#app {
  min-height: 100vh;
}

.app {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 32px 40px 48px;
  gap: 24px;
}

.app-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 16px 24px;
  background: #1f1f1f;
  color: #f7f0e8;
  border-radius: 20px;
  box-shadow: 0 20px 40px rgba(31, 31, 31, 0.18);
}

.app-header h1 {
  margin: 0;
  font-size: 24px;
}

.app-kicker {
  margin: 0 0 8px;
  font-size: 12px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
