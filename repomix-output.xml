  border: 1px dashed #b9b0a3;
  padding: 12px 16px;
  border-radius: 12px;
  cursor: pointer;
  background: #f8f4ef;
}

.upload input {
  display: none;
}

.image-preview {
  margin-top: 16px;
  border-radius: 16px;
