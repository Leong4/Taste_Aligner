}

.nav {
  display: flex;
  gap: 12px;
}

.nav-button {
  border: 1px solid rgba(247, 240, 232, 0.2);
  background: transparent;
  color: #f7f0e8;
  padding: 8px 16px;
  border-radius: 999px;
  cursor: pointer;
  font-weight: 600;
  transition: all 0.2s ease;
}

.nav-button.active,
.nav-button:hover:not(:disabled) {
  background: #f7c977;
  color: #1f1f1f;
  border-color: #f7c977;
}

.nav-button:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

.app-main {
  flex: 1;
  display: flex;
}

.panel {
  width: 100%;
  background: #ffffff;
  border-radius: 20px;
  padding: 28px 32px;
  box-shadow: 0 18px 40px rgba(31, 31, 31, 0.08);
}

.panel h2 {
  margin-top: 0;
}

.muted {
  color: #666;
  margin-top: 0;
}

.city-form {
  display: flex;
  gap: 12px;
  margin-top: 16px;
}

.city-form input {
  flex: 1;
  border-radius: 12px;
  border: 1px solid #d0c7bc;
  padding: 12px 16px;
  font-size: 16px;
}

.city-form button {
  border-radius: 12px;
  border: none;
  background: #1f1f1f;
  color: #fff;
  padding: 12px 18px;
  font-weight: 600;
  cursor: pointer;
}

.city-form button:disabled {
  opacity: 0.6;
