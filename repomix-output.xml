                fallback_used: false,
            },
        };
    }
}

class ThrowingAdapter {
    constructor(message = "Timeout") {
        this.message = message;
        this.modelInfo = { provider: "mock", model_name: "mock-v1", version: "1.0.0" };
    }

    async generateStructuredJSON() {
        throw new Error(this.message);
    }
}

