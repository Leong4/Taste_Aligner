            data: this.data,
            usage: { prompt_tokens: 0, completion_tokens: 0, total_tokens: 0 },
            callTrace: {
                model: this.modelInfo,
                temperature: input.temperature,
                prompt_version: input.promptVersion,
                latency_ms: 0,
